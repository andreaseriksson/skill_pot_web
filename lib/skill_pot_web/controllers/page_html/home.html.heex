<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-100">
  <header class="navbar bg-base-100/80 backdrop-blur sticky top-0 z-30 border-b border-base-200 px-4 sm:px-8">
    <div class="flex-1">
      <a href="/" class="flex items-center gap-2 font-semibold text-lg">
        <span class="inline-flex items-center justify-center size-8 rounded-lg bg-primary text-primary-content">
          <.icon name="hero-sparkles-solid" class="size-5" />
        </span>
        SkillPot <span class="badge badge-soft badge-sm ml-1">.dev</span>
      </a>
    </div>
    <div class="flex-none flex items-center gap-2">
      <ul class="hidden md:flex items-center gap-1 text-sm">
        <li><a href="#features" class="btn btn-ghost btn-sm">Features</a></li>
        <li><a href="#how" class="btn btn-ghost btn-sm">How it works</a></li>
        <li><a href="#pricing" class="btn btn-ghost btn-sm">Pricing</a></li>
      </ul>
      <a href="#pricing" class="btn btn-primary btn-sm ml-2">Get SkillPot</a>
    </div>
  </header>

  <section class="px-4 sm:px-8 pt-20 pb-16 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="badge badge-soft badge-primary mb-6">
          <.icon name="hero-cpu-chip-micro" class="size-3.5" /> macOS · Local-first
        </div>
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-balance leading-[1.05]">
          One skill library. <span class="text-primary">Every project.</span>
        </h1>
        <p class="mt-6 text-lg text-base-content/70 max-w-xl leading-relaxed">
          SkillPot is the local-first macOS app for managing reusable coding-agent skills.
          Maintain a canonical library once, bind it to any local project, and sync clean <code class="kbd kbd-sm">AGENTS.md</code>, <code class="kbd kbd-sm">CLAUDE.md</code>, and
          <code class="kbd kbd-sm">.cursor/rules</code>
          files in a click.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#pricing" class="btn btn-primary">
            Download for macOS <.icon name="hero-arrow-right-micro" class="size-4" />
          </a>
          <a href="#how" class="btn btn-ghost">
            See how it works
          </a>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-base-content/60">
          <div class="flex items-center gap-2">
            <.icon name="hero-check-circle-micro" class="size-4 text-success" /> Works offline
          </div>
          <div class="flex items-center gap-2">
            <.icon name="hero-check-circle-micro" class="size-4 text-success" /> No telemetry
          </div>
          <div class="flex items-center gap-2">
            <.icon name="hero-check-circle-micro" class="size-4 text-success" /> One-time purchase
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-8 bg-gradient-to-tr from-primary/20 via-secondary/10 to-transparent blur-3xl -z-10">
        </div>
        <div class="mockup-window border border-base-300 bg-base-200 shadow-2xl">
          <div class="bg-base-100 aspect-[16/10] flex items-center justify-center text-base-content/40">
            <div class="text-center space-y-3">
              <.icon name="hero-photo" class="size-12 mx-auto opacity-50" />
              <p class="text-sm font-medium">App screenshot</p>
              <p class="text-xs opacity-60">Replace with /images/app-preview.png</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-base-200/50 border-y border-base-200">
    <div class="px-4 sm:px-8 py-6 max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-x-12 gap-y-3 text-sm text-base-content/60">
      <span>Built for users of</span>
      <span class="font-semibold text-base-content/80">Claude Code</span>
      <span class="font-semibold text-base-content/80">Cursor</span>
      <span class="font-semibold text-base-content/80">Codex</span>
      <span class="font-semibold text-base-content/80">Windsurf</span>
      <span class="font-semibold text-base-content/80">Aider</span>
    </div>
  </section>

  <section id="how" class="px-4 sm:px-8 py-24 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="badge badge-soft mb-4">How it works</div>
      <h2 class="text-4xl font-bold tracking-tight">The skill loop, finally one-way</h2>
      <p class="mt-4 text-base-content/70">
        Canonical skills flow into project bindings, project bindings generate the files your
        agent reads. No more copy-pasting prompts between repos.
      </p>
    </div>

    <ul class="steps steps-vertical lg:steps-horizontal w-full">
      <li class="step step-primary">
        <div class="text-left mt-3 max-w-xs">
          <p class="font-semibold">Curate a skill</p>
          <p class="text-sm text-base-content/60">
            Write or import once. Edit, duplicate, archive, restore.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="text-left mt-3 max-w-xs">
          <p class="font-semibold">Bind to a project</p>
          <p class="text-sm text-base-content/60">
            Point SkillPot at a local folder and pick the skills that apply.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="text-left mt-3 max-w-xs">
          <p class="font-semibold">Preview the diff</p>
          <p class="text-sm text-base-content/60">
            See exactly what AGENTS.md, CLAUDE.md, and .cursor/rules will look like.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="text-left mt-3 max-w-xs">
          <p class="font-semibold">Sync to project</p>
          <p class="text-sm text-base-content/60">
            Write generated files. Re-sync any time skills evolve.
          </p>
        </div>
      </li>
    </ul>
  </section>

  <section id="features" class="bg-base-200/50 border-y border-base-200">
    <div class="px-4 sm:px-8 py-24 max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="badge badge-soft mb-4">Features</div>
        <h2 class="text-4xl font-bold tracking-tight">Everything around one tidy library</h2>
        <p class="mt-4 text-base-content/70">
          Treat your agent instructions like source: searchable, versioned, and reused everywhere.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-2">
              <.icon name="hero-folder-open" class="size-5" />
            </div>
            <h3 class="card-title text-lg">Local skill library</h3>
            <p class="text-sm text-base-content/70">
              Every skill lives on disk in your home folder. Yours. Diffable. Backed up however you like.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="size-10 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center mb-2">
              <.icon name="hero-magnifying-glass" class="size-5" />
            </div>
            <h3 class="card-title text-lg">Search and filter</h3>
            <p class="text-sm text-base-content/70">
              Find the right skill by tag, project, or full-text — no more scrolling through markdown files.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="size-10 rounded-lg bg-accent/10 text-accent flex items-center justify-center mb-2">
              <.icon name="hero-document-duplicate" class="size-5" />
            </div>
            <h3 class="card-title text-lg">Bind to many projects</h3>
            <p class="text-sm text-base-content/70">
              One source skill, many bindings. Update once, re-sync everywhere it's installed.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="size-10 rounded-lg bg-info/10 text-info flex items-center justify-center mb-2">
              <.icon name="hero-eye" class="size-5" />
            </div>
            <h3 class="card-title text-lg">Preview before write</h3>
            <p class="text-sm text-base-content/70">
              Inspect the exact AGENTS.md, CLAUDE.md, or .cursor/rules output before anything touches disk.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="size-10 rounded-lg bg-warning/10 text-warning flex items-center justify-center mb-2">
              <.icon name="hero-exclamation-triangle" class="size-5" />
            </div>
            <h3 class="card-title text-lg">Conflict detection</h3>
            <p class="text-sm text-base-content/70">
              SkillPot spots external edits and gives you a clear path to merge, overwrite, or skip.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300">
          <div class="card-body">
            <div class="size-10 rounded-lg bg-success/10 text-success flex items-center justify-center mb-2">
              <.icon name="hero-arrow-down-tray" class="size-5" />
            </div>
            <h3 class="card-title text-lg">Import & export</h3>
            <p class="text-sm text-base-content/70">
              Move skill packages between machines or share them with teammates as portable bundles.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="px-4 sm:px-8 py-24 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="badge badge-soft mb-4">Pricing</div>
      <h2 class="text-4xl font-bold tracking-tight">Pick the version that fits</h2>
      <p class="mt-4 text-base-content/70">
        Start solo with a one-time purchase. Add team sync, reviews, and GitHub integration when you're ready.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <h3 class="card-title text-2xl">Personal</h3>
            <span class="badge badge-soft">Mac App Store</span>
          </div>
          <p class="text-sm text-base-content/70">
            For solo developers running agents locally.
          </p>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-4xl font-bold">$49</span>
            <span class="text-base-content/60 text-sm">one-time</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm">
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Local skill library, unlimited projects
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Create, edit, duplicate, archive, restore
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Generate AGENTS.md, CLAUDE.md, .cursor/rules/project.mdc
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Search, filter, import/export packages
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Local backup & restore
            </li>
          </ul>
          <div class="card-actions mt-8">
            <a href="#" class="btn btn-primary btn-block">Buy Personal</a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 border-2 border-primary relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
          <span class="badge badge-primary">Coming soon</span>
        </div>
        <div class="card-body">
          <div class="flex items-center justify-between">
            <h3 class="card-title text-2xl">Pro / Team</h3>
            <span class="badge badge-soft badge-primary">1-week trial</span>
          </div>
          <p class="text-sm text-base-content/70">
            For teams who want a shared, reviewed library.
          </p>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-4xl font-bold">$12</span>
            <span class="text-base-content/60 text-sm">/ user / month</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm">
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Everything in Personal
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Cloud sync across devices & teammates
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Shared team library with roles & review
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Version history across devices
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              GitHub App: branch, commit, open PRs
            </li>
            <li class="flex gap-2">
              <.icon name="hero-check-circle-micro" class="size-4 text-success mt-0.5 shrink-0" />
              Import/export skills from GitHub repos
            </li>
          </ul>
          <div class="card-actions mt-8">
            <a href="#" class="btn btn-primary btn-block btn-outline">Join the waitlist</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 sm:px-8 pb-24 max-w-5xl mx-auto">
    <div class="card bg-gradient-to-br from-primary/10 via-base-200 to-secondary/10 border border-base-300">
      <div class="card-body items-center text-center py-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight max-w-xl">
          Stop pasting prompts. Start shipping skills.
        </h2>
        <p class="mt-3 text-base-content/70 max-w-lg">
          SkillPot keeps your agent instructions clean, reusable, and in sync with every project on your Mac.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 justify-center">
          <a href="#pricing" class="btn btn-primary">
            Download for macOS <.icon name="hero-arrow-right-micro" class="size-4" />
          </a>
          <a href="https://github.com/" class="btn btn-ghost">
            <.icon name="hero-book-open" class="size-4" /> Read the docs
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer footer-center bg-base-200 text-base-content/70 p-10 border-t border-base-300">
    <aside>
      <div class="flex items-center gap-2 font-semibold text-base-content">
        <span class="inline-flex items-center justify-center size-7 rounded-lg bg-primary text-primary-content">
          <.icon name="hero-sparkles-solid" class="size-4" />
        </span>
        SkillPot
      </div>
      <p class="text-sm">Local-first agent skill management for macOS.</p>
      <p class="text-xs">
        © {Date.utc_today().year} SkillPot.dev — Built with Phoenix v{Application.spec(
          :phoenix,
          :vsn
        )}
      </p>
    </aside>
  </footer>
</div>
